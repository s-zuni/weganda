{
  "expo": {
    "name": "우간다",
    "slug": "weganda",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "weganda",
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weganda.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "근무표를 스마트폰 기본 캘린더에 동기화하기 위해 캘린더 접근 권한이 필요합니다.",
        "NSRemindersUsageDescription": "임상 알람을 리마인더에 등록하기 위해 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "근무표 이미지를 업로드하거나 커뮤니티 게시글에 사진을 첨부하기 위해 사진 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "근무표를 직접 촬영하여 OCR로 자동 입력하기 위해 카메라 접근 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.weganda.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-calendar",
        {
          "calendarPermission": "근무표를 휴대폰 기본 캘린더에 동기화하기 위해 권한이 필요합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF507C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "근무표 이미지 업로드 및 커뮤니티 사진 첨부를 위해 사진 라이브러리 접근 권한이 필요합니다.",
          "cameraPermission": "근무표를 직접 촬영하여 OCR로 자동 입력하기 위해 카메라 접근 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ac5c519-0cdd-4ba7-9f05-27d7bf82a317"
      }
    },
    "owner": "szuni"
  }
}
