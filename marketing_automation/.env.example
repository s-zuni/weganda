# ==============================================================================
# weganda Marketing Automation Environment Configuration Template
# ⚠️ 주의: 실제 API 키와 민감 정보는 이 파일이 아닌 '.env' 파일에만 작성하세요.
# '.env' 파일은 절대 Git 저장소에 커밋해서는 안 됩니다. (.gitignore 등록됨)
# ==============================================================================

# 1. Google Gemini AI 설정
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Telegram 승인 봇 설정 (보안 화이트리스트 적용)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 관리자 Telegram User ID (정수형 숫자). 이 ID를 가진 사용자만 승인/명령어 실행 가능 (미인가 접근 원천 차단)
TELEGRAM_ADMIN_CHAT_ID=123456789

# 3. weganda Supabase 커뮤니티 연동 설정
SUPABASE_URL=https://your-project.supabase.co
# 공식 채용 봇 글 등록을 위한 Service Role Key (서버 사이드 전용)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# '우간다 채용 알리미 🤖' 공식 계정의 profiles.id (UUID)
OFFICIAL_BOT_AUTHOR_ID=00000000-0000-0000-0000-000000000000

# 4. Meta Instagram Graph API 설정
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_access_token

# 5. Meta Threads API 설정
THREADS_USER_ID=your_threads_user_id
THREADS_ACCESS_TOKEN=your_threads_access_token

# 6. 미디어 호스팅 (Instagram/Threads 컨테이너 게시용 공개 이미지 호스팅)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# 7. 실행 스케줄 설정 (KST 기준)
SCHEDULE_TIME_KST=08:30
TIMEZONE=Asia/Seoul

# 8. 운영 안전장치
# true면 실제 발행 없이 텔레그램 미리보기만 수행 (실서비스 전환 전까지 true 유지)
DRY_RUN=true
# true일 때만 크롤러 Mock 공고 사용 허용 (실발행 시 반드시 false)
ALLOW_MOCK_JOBS=false
MAX_POSTS_PER_DAY=1
# 쓰레드/캡션/CTA 슬라이드에 표기할 앱 다운로드 링크 및 인스타 계정
APP_DOWNLOAD_URL=
INSTAGRAM_HANDLE=

# 9. Meta 토큰 갱신용 (insta_auto의 token_refresh 방식과 동일)
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
THREADS_APP_SECRET=your_threads_app_secret
INSTAGRAM_GRAPH_VERSION=v21.0
THREADS_API_VERSION=v1.0

# 10. 채용공고 수집 API
# 잡알리오(공공기관 채용) — 공공데이터포털 '재정경제부_공공기관 채용정보 조회서비스' 서비스키 (국립대병원·공공병원 자동 수집)
DATA_GO_KR_SERVICE_KEY=your_data_go_kr_service_key
# 고용24(워크넷) 채용정보 API — 기업회원으로 발급받은 키만 사용 가능 (개인회원 키는 '개인회원은 사용할 수 없는 OPEN-API' 오류)
WORKNET_API_KEY=
# 마감까지 N일 미만 남은 공고는 추천에서 제외
JOB_MIN_DDAY=2

# 11. 배포(Railway) 전용
# Volume을 마운트한 경로. state.db(중복 발행 방지·승인 대기 기록)를 영구 보존합니다. 로컬에서는 비워두면 프로젝트 폴더를 사용.
DATA_DIR=
# Railway 로그가 즉시 보이도록 (Railway 변수에 PYTHONUNBUFFERED=1 추가)
